import streamlit as st
import html
import re
import time

# ---------------------------------------------------------
# 1. إعدادات الصفحة الأساسية (كودك الأصلي كما هو)
# ---------------------------------------------------------
st.set_page_config(page_title="PlotCraft UI", layout="wide", initial_sidebar_state="collapsed")

# ---------------------------------------------------------
# 2. منظومة الحماية والأمان (Security Layer)
# ---------------------------------------------------------

# أ) دالة تنظيف المدخلات وتأمينها ضد هجمات الحقن (Sanitization)
def sanitize_input(user_input):
    if not isinstance(user_input, str):
        return user_input
    # تنظيف النص من أكواد HTML أو JavaScript الخبيثة
    cleaned = html.escape(user_input)
    # إزالة أي رموز قد تُستغل في هجمات SQL Injection أو الأوامر الضارة
    cleaned = re.sub(r'[;\'"\\--]', '', cleaned)
    return cleaned.strip()

# ب) دالة تأمين الجلسة وتوليد رمز حماية فريد (Session Security)
def init_secure_session():
    if "security_token" not in st.session_state:
        import uuid
        st.session_state.security_token = str(uuid.uuid4())
    
    if "is_subscribed" not in st.session_state:
        # حالة الاشتراك الإفتراضية (يتم تحديثها عند فحص الدفع/الاشتراك)
        st.session_state.is_subscribed = False

# ج) دالة منع الضغط المتكرر لحماية السيرفر وخدمة التوليد (Rate Limiting)
def check_rate_limit(action_name="default", delay_seconds=2):
    current_time = time.time()
    last_action_key = f"last_time_{action_name}"
    
    if last_action_key in st.session_state:
        elapsed = current_time - st.session_state[last_action_key]
        if elapsed < delay_seconds:
            st.warning("⚠️ يرجى الانتظار لحظات قبل تنفيذ الطلب مرة أخرى.")
            return False
            
    st.session_state[last_action_key] = current_time
    return True

# د) دالة التحقق الصارم من اشتراك المستخدم قبل توليد الفيديو
def verify_subscription():
    # هنا يتم الفحص هل المستخدم يملك اشتراكاً فعالاً (أسبوعي/شهري/سنوي)
    if not st.session_state.get("is_subscribed", False):
        st.error("🔒 هذه الميزة تطلب اشتراكاً فعالاً (أسبوعي، شهري، أو سنوي).")
        return False
    return True

# ---------------------------------------------------------
# تفعيل نظام الحماية فور تحميل الصفحة
# ---------------------------------------------------------
init_secure_session()
