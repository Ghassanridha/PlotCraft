// دالة لتوليد رقم آيدي ثابت حصرياً بناءً على معرف Firebase (UID) الخاص بالمستخدم
function getPersistentNumericID(uid) {
    let hash = 0;
    for (let i = 0; i < uid.length; i++) {
        hash = ((hash << 5) - hash) + uid.charCodeAt(i);
        hash |= 0;
    }
    // يضمن لك أن الناتج رقم موجب وبطول ثابت لا يتغير أبداً لهذا المستخدم
    return Math.abs(hash).toString().substring(0, 7);
}

// دوال التنقل بين الشاشات
function switchScreen(screenId, event) {
    var screens = document.querySelectorAll('.screen-view');
    screens.forEach(s => s.classList.remove('active'));
    
    let targetScreen = document.getElementById(screenId);
    if (targetScreen) {
        targetScreen.classList.add('active');
    }
}

