// دوال تسجيل الدخول وحفظ البيانات مع التحقق الأمني الأولي
function handleExistingLogin() {
    let emailField = document.getElementById('loginEmailField');
    let passField = document.getElementById('loginPasswordField');
    
    if (!emailField || !passField) return;

    let email = emailField.value.trim();
    let pass = passField.value.trim();

    // فحص الأمان الأساسي: منع الإرسال إذا كانت الحقول فارغة
    if (email === "" || pass === "") {
        alert("⚠️ يرجى ملء جميع الحقول المطلوبة.");
        return;
    }

    // فحص تنسيق البريد الإلكتروني لمنع الإدخال العشوائي
    let emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
        alert("⚠️ يرجى إدخال بريد إلكتروني صالح.");
        return;
    }

    // ... استكمال التحقق وتسجيل الدخول بأمان ...
}

// دالة تسجيل الدخول عبر جوجل بشكل آمن ومحمي
function handleGoogleLogin() {
    let redirectUri = "https://plotcraft-s84ivmhu8safjehv7vxwvs.streamlit.app";
    
    // توليد رمز حالة عشوائي لحماية المصادقة ضد هجمات التلاعب (CSRF)
    let secureState = Math.random().toString(36).substring(2);
    sessionStorage.setItem('oauth_state', secureState);

    let authUrl = "https://accounts.google.com/o/oauth2/v2/auth?response_type=code" 
        + "&redirect_uri=" + encodeURIComponent(redirectUri) 
        + "&scope=openid%20email%20profile"
        + "&state=" + secureState;
    
    window.location.href = authUrl;
}
