// دالة لتوليد آيدي ثابت لكل مستخدم بناءً على معرف Firebase الخاص به
function getUserFixedID(firebaseUid) {
    let shortId = firebaseUid.substring(0, 7).toUpperCase();
    return shortId + " ID";
}

// دالة التنقل بين الشاشات
function switchScreen(screenId, event) {
    if (event) event.preventDefault();
    var screens = document.querySelectorAll('.screen-view');
    screens.forEach(s => s.classList.remove('active'));
    
    let targetScreen = document.getElementById(screenId);
    if (targetScreen) {
        targetScreen.classList.add('active');
    }
}

// دالة تغيير اللغة
function applySelectedLanguage() {
    if (typeof tempSelectedLangName !== 'undefined') {
        var langName = tempSelectedLangName;
        let displayEl = document.getElementById('currentLangDisplay');
        if (displayEl) {
            displayEl.innerText = langName;
        }
    }
}

// دالة إنشاء حساب جديد مع آيدي ثابت
function handleCreateNewAccount() {
    let emailField = document.getElementById('regEmailField') || document.getElementById('registerEmailField');
    let passField = document.getElementById('regPasswordField') || document.getElementById('registerPasswordField');
    
    if (!emailField || !passField) return;

    let email = emailField.value.trim();
    let pass = passField.value.trim();

    if (email === "" || pass === "") {
        if (typeof showToast === 'function') showToast("يرجى ملء جميع الحقول");
        else alert("⚠️ يرجى ملء جميع الحقول المطلوبة لإنشاء الحساب.");
        return;
    }

    if (pass.length <= 6) {
        if (typeof showToast === 'function') showToast("كلمة المرور يجب أن تكون أكثر من 6 أحرف");
        else alert("⚠️ كلمة المرور قصيرة جداً.");
        return;
    }

    createUserWithEmailAndPassword(auth, email, pass)
        .then((userCredential) => {
            let user = userCredential.user;
            let fixedID = getUserFixedID(user.uid); // آيدي ثابت لا يتغير
            let newUser = { 
                email: user.email, 
                name: user.email.split('@')[0], 
                id: fixedID 
            };

            if (typeof setCurrentUser === 'function') setCurrentUser(newUser);
            if (typeof updateUIState === 'function') updateUIState();
            if (typeof closeRegisterModal === 'function') closeRegisterModal();
            
            emailField.value = '';
            passField.value = '';

            if (typeof showToast === 'function') showToast("تم إنشاء الحساب وإرساله إلى Firebase بنجاح!");
            else alert("✅ تم إنشاء الحساب بنجاح!");
        })
        .catch((error) => {
            let errorMessage = error.message;
            if (typeof showToast === 'function') showToast("خطأ: " + errorMessage);
            else alert("❌ خطأ في إنشاء الحساب: " + errorMessage);
        });
}

// دالة تسجيل الدخول للحسابات الموجودة مع استرجاع نفس الآيدي الثابت
function handleExistingLogin() {
    let emailField = document.getElementById('loginEmailField');
    let passField = document.getElementById('loginPasswordField');
    
    if (!emailField || !passField) return;

    let email = emailField.value.trim();
    let pass = passField.value.trim();

    if (email === "" || pass === "") {
        if (typeof showToast === 'function') showToast("يرجى ملء جميع الحقول");
        else alert("⚠️ يرجى ملء جميع الحقول المطلوبة.");
        return;
    }

    signInWithEmailAndPassword(auth, email, pass)
        .then((userCredential) => {
            let user = userCredential.user;
            let fixedID = getUserFixedID(user.uid); // استرجاع نفس الآيدي الثابت الخاص به
            let loggedUser = {
                email: user.email,
                name: user.displayName || user.email.split('@')[0],
                id: fixedID
            };

            if (typeof setCurrentUser === 'function') setCurrentUser(loggedUser);
            if (typeof updateUIState === 'function') updateUIState();
            if (typeof closeLoginModal === 'function') closeLoginModal();
            
            emailField.value = '';
            passField.value = '';

            if (typeof showToast === 'function') showToast("تم تسجيل الدخول بنجاح!");
            else alert("✅ تم تسجيل الدخول بنجاح!");
        })
        .catch((error) => {
            let errorMessage = error.message;
            if (typeof showToast === 'function') showToast("خطأ في تسجيل الدخول");
            else alert("❌ بيانات الدخول غير صحيحة أو الحساب غير موجود.");
        });
}

