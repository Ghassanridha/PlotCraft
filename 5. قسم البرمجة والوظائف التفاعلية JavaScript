// دالة إنشاء حساب جديد (مستخدم جديد لأول مرة)
function handleRegister() {
    let emailField = document.getElementById('registerEmailField'); // تأكد من مطابقة الـ id في واجهة المستخدم لديك
    let passField = document.getElementById('registerPasswordField');
    
    if (!emailField || !passField) return;

    let email = emailField.value.trim();
    let pass = passField.value.trim();

    if (email === "" || pass === "") {
        alert("⚠️ يرجى ملء جميع الحقول المطلوبة لإنشاء الحساب.");
        return;
    }

    createUserWithEmailAndPassword(auth, email, pass)
        .then((userCredential) => {
            let user = userCredential.user;
            alert("✅ تم إنشاء الحساب بنجاح! أهلاً بك: " + user.email);
            switchScreen('mainAppScreen');
        })
        .catch((error) => {
            let errorMessage = error.message;
            alert("❌ خطأ في إنشاء الحساب: " + errorMessage);
        });
}

// دالة تسجيل الدخول للحسابات الموجودة مسبقاً (تم تصحيح .error إلى .catch)
function handleExistingLogin() {
    let emailField = document.getElementById('loginEmailField');
    let passField = document.getElementById('loginPasswordField');
    
    if (!emailField || !passField) return;

    let email = emailField.value.trim();
    let pass = passField.value.trim();

    // فحص الأمان الأساسي: منع الإرسال إذا كانت الحقول فارغة
    if (email === "" || pass === "") {
        alert("⚠️ يرجى ملء جميع الحقول المطلوبة.");
        return;
    }

    // فحص تنسيق البريد الإلكتروني لمنع الإدخال العشوائي
    let emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
        alert("⚠️ يرجى إدخال بريد إلكتروني صالح.");
        return;
    }

    // إرسال البيانات إلى سحابة Firebase لتسجيل الدخول
    signInWithEmailAndPassword(auth, email, pass)
        .then((userCredential) => {
            let user = userCredential.user;
            alert("✅ تم تسجيل الدخول بنجاح! أهلاً بك: " + user.email);
            switchScreen('mainAppScreen');
        })
        .catch((error) => { // تم التصحيح هنا من .error إلى .catch الصحيحة
            let errorMessage = error.message;
            alert("❌ خطأ في تسجيل الدخول: " + errorMessage);
        });
}

