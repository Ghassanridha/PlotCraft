        window.handleCreateNewAccount = function() {
            let email = document.getElementById('regEmailField').value.trim();
            let pass = document.getElementById('regPasswordField').value.trim();

            if (!email || !pass) {
                showToast("يرجى ملء جميع الحقول");
                return;
            }

            if (pass.length < 6) {
                showToast("كلمة المرور يجب ألا تقل عن 6 أحرف");
                return;
            }

            createUserWithEmailAndPassword(auth, email, pass)
                .then((userCredential) => {
                    closeRegisterModal();
                    document.getElementById('regEmailField').value = '';
                    document.getElementById('regPasswordField').value = '';
                    showToast("تم إنشاء الحساب بنجاح!");
                })
                .catch((error) => {
                    showToast("خطأ في إنشاء الحساب: " + error.message);
                });
        };

