        window.submitCharacterData = function() {
            var nameInput = document.getElementById('characterNameInput').value.trim();
            if (currentUploadedImageSrc === "" || nameInput === "") return;

            let isNameExists = addedCharactersList.some(c => c.name.toLowerCase() === nameInput.toLowerCase());
            if (isNameExists) {
                showToast("عذراً، هذا الاسم مضاف سابقاً! اختر اسماً آخر.");
                return;
            }

            let isImgExists = addedCharactersList.some(c => c.img === currentUploadedImageSrc);
            if (isImgExists) {
                showToast("عذراً، هذه الصورة مضافة سابقاً! اختر صورة أخرى.");
                return;
            }

            addedCharactersList.push({
                name: nameInput,
                img: currentUploadedImageSrc
            });

            renderCharactersUI();
            updateCounter();
            switchScreen('stepByStepScreen', event);
        };

        window.renderCharactersUI = function() {
            let container = document.getElementById('charAddedPreviewBox');
            container.innerHTML = '';

            if (addedCharactersList.length > 0) {
                document.getElementById('charAddBtn').style.display = 'none';
                document.getElementById('charControlsGroup').style.display = 'flex';
                container.style.display = 'flex';

                addedCharactersList.forEach((char) => {
                    let chip = document.createElement('div');
                    chip.className = 'single-char-chip';
                    chip.innerHTML = `<img src="${char.img}" class="char-added-img"><span class="char-added-name">${char.name}</span>`;
                    container.appendChild(chip);
                });

                if (addedCharactersList.length === 1) {
                    document.getElementById('addSecondCharBtn').style.display = 'flex';
                } else {
                    document.getElementById('addSecondCharBtn').style.display = 'none';
                }
            } else {
                document.getElementById('charAddBtn').style.display = 'block';
                document.getElementById('charControlsGroup').style.display = 'none';
                container.style.display = 'none';
                document.getElementById('addSecondCharBtn').style.display = 'none';
            }
        };

