    // تسجيل تحميل هذا القسم في النظام العام
    window.PlotCraftModules = window.PlotCraftModules || {};
    window.PlotCraftModules.subscriptionAndAuthLoaded = true;

    // أداة قراءة وحقن الملف خارجياً إذا تم جلبه عبر السيرفر أو الجافاسكريبت
    (function loadSubscriptionModule() {
        console.log("تم تحميل قسم الاشتراكات وتسجيل الدخول بنجاح وجاهز للعمل.");
    })();
</script>
