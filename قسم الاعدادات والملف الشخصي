<!-- تعديل عرض الأيدي ليكون أرقاماً فقط (7 منازل) -->
<!-- ========================================== -->
<script>
    // دالة نسخ المعرف (ID) إلى الحافظة عند النقر على المربع
    window.copyUserIdToClipboard = function() {
        let idText = document.getElementById('displayUniqueId').innerText;
        navigator.clipboard.writeText(idText).then(() => {
            showToast("تم نسخ المعرف: " + idText);
        }).catch(err => {
            showToast("فشل النسخ");
        });
    };

    // دالة مساعدة لضمان توليد أو عرض أرقام فقط (7 أرقام) إذا لم يكن موجوداً
    window.ensureNumericSevenDigitId = function() {
        let idElement = document.getElementById('displayUniqueId');
        if (idElement) {
            let currentText = idElement.innerText.trim();
            // إذا كان يحتوي على أحرف أو ليس مكوناً من 7 أرقام، نقوم بتوليد 7 أرقام عشوائية ثابتة له
            let digitsOnly = currentText.replace(/\D/g, '');
            if (digitsOnly.length !== 7) {
                let random7 = Math.floor(1000000 + Math.random() * 9000000).toString();
                idElement.innerText = random7;
            }
        }
    };

    // تشغيل التحقق والتعديل فور تحميل القسم
    document.addEventListener("DOMContentLoaded", function() {
        ensureNumericSevenDigitId();
    });

    window.PlotCraftModules = window.PlotCraftModules || {};
    window.PlotCraftModules.settingsAndProfileLoaded = true;
</script>
