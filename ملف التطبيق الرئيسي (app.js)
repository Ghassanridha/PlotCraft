window.handleExistingLogin = function() {
    let email = document.getElementById('loginEmailField').value.trim();
    let pass = document.getElementById('loginPasswordField').value.trim();

    if (!email || !pass) {
        showToast("يرجى ملء جميع الحقول");
        return;
    }

    let users = getRegisteredUsers();
    let found = users.find(u => u.email === email && u.password === pass);

    if (found) {
        setCurrentUser(found);
        updateUIState();
        closeLoginModal();
        
        document.getElementById('loginEmailField').value = '';
        document.getElementById('loginPasswordField').value = '';
        
        showToast("تم تسجيل الدخول بنجاح");
    } else {
        showToast("بيانات الدخول غير صحيحة");
    }
};

window.handleCreateNewAccount = function() {
    let email = document.getElementById('regEmailField').value.trim();
    let pass = document.getElementById('regPasswordField').value.trim();

    if (!email || !pass) {
        showToast("يرجى ملء جميع الحقول");
        return;
    }

    if (pass.length <= 6) {
        showToast("كلمة المرور يجب أن تكون أكثر من 6 أحرف");
        return;
    }

    let users = getRegisteredUsers();
    let existing = users.find(u => u.email === email);

    if (existing) {
        showToast("هذا الحساب مسجل مسبقاً");
        return;
    }

    let uniqueID = generateUniqueID();
    let newUser = { 
        email: email, 
        password: pass, 
        name: email.split('@')[0], 
        id: uniqueID 
    };

    users.push(newUser);
    saveUsers(users);
    setCurrentUser(newUser);

    updateUIState();
    closeRegisterModal();

    document.getElementById('regEmailField').value = '';
    document.getElementById('regPasswordField').value = '';

    showToast("تم تسجيل الحساب بنجاح");
};

window.handleGoogleCredentialResponse = function(response) {
    try {
        let base64Url = response.credential.split('.')[1];
        let base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
        let jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
            return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
        }).join(''));

        let googleUser = JSON.parse(jsonPayload);
        let email = googleUser.email;
        let name = googleUser.name || email.split('@')[0];

        let users = getRegisteredUsers();
        let existingUser = users.users.find(u => u.email === email);

        let userObj;
        if (existingUser) {
            userObj = existingUser;
        } else {
            userObj = {
                email: email,
                password: "GOOGLE_OAUTH_USER",
                name: name,
                id: generateUniqueID()
            };
            users.push(userObj);
            saveUsers(users);
        }

        setCurrentUser(userObj);
        updateUIState();
        closeLoginModal();
        showToast("تم تسجيل الدخول بواسطة جوجل بنجاح!");
    } catch (e) {
        showToast("فشل تسجيل الدخول عبر جوجل");
    }
};
