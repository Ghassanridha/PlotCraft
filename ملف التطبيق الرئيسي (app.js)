function getRegisteredUsers() {
    return JSON.parse(localStorage.getItem('plotcraft_db_users')) || [];
}

function saveUsers(usersArray) {
    localStorage.setItem('plotcraft_db_users', JSON.stringify(usersArray));
}

function getCurrentUser() {
    return JSON.parse(localStorage.getItem('plotcraft_current_user')) || null;
}

function setCurrentUser(userObj) {
    if (userObj) {
        localStorage.setItem('plotcraft_current_user', JSON.stringify(userObj));
    } else {
        localStorage.removeItem('plotcraft_current_user');
    }
}

function generateUniqueID() {
    let users = getRegisteredUsers();
    let newId = "";
    let exists = true;
    while (exists) {
        newId = Math.floor(1000000 + Math.random() * 9000000).toString();
        exists = users.some(u => u.id === newId + " ID");
    }
    return newId + " ID";
}

function updateUIState() {
    let currentUser = getCurrentUser();
    if (currentUser) {
        document.getElementById('displayUserName').innerText = currentUser.name || currentUser.email.split('@')[0];
        document.getElementById('displayUniqueId').innerText = currentUser.id;
        document.getElementById('settingsLoginBtn').style.display = 'none';
        document.getElementById('settingsLogoutBtn').style.display = 'block';
        document.getElementById('loggedOutUserInfoArea').style.display = 'none';
        document.getElementById('loggedInUserInfoArea').style.display = 'flex';
    } else {
        document.getElementById('settingsLoginBtn').style.display = 'block';
        document.getElementById('settingsLogoutBtn').style.display = 'none';
        document.getElementById('loggedInUserInfoArea').style.display = 'none';
        document.getElementById('loggedOutUserInfoArea').style.display = 'flex';
    }
}

window.onload = function() {
    updateUIState();
    window.history.pushState({page: "main"}, document.title, window.location.href);
};

window.addEventListener('popstate', function(event) {
    let webView = document.getElementById('webViewScreen');
    let loginModal = document.getElementById('loginModalOverlay');
    let regModal = document.getElementById('registerModalOverlay');
    let subModal = document.getElementById('subscriptionModal');
    let langModal = document.getElementById('languageModalOverlay');
    
    if (webView.classList.contains('active')) {
        closeWebView();
        window.history.pushState({page: "main"}, document.title, window.location.href);
        event.preventDefault();
    } else if (loginModal.classList.contains('show')) {
        closeLoginModal();
        window.history.pushState({page: "main"}, document.title, window.location.href);
        event.preventDefault();
    } else if (regModal.classList.contains('show')) {
        closeRegisterModal();
        window.history.pushState({page: "main"}, document.title, window.location.href);
        event.preventDefault();
    } else if (!subModal.classList.contains('hidden')) {
        closeSubscriptionModal();
        window.history.pushState({page: "main"}, document.title, window.location.href);
        event.preventDefault();
    } else if (langModal.classList.contains('show')) {
        closeLanguageModal();
        window.history.pushState({page: "main"}, document.title, window.location.href);
        event.preventDefault();
    }
});

