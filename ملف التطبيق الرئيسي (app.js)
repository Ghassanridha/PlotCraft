window.saveNewUserName = function(event) {
    if (event) event.stopPropagation();
    var val = document.getElementById('editNameInputField').value.trim();
    if (val !== "") {
        let currentUser = getCurrentUser();
        if (currentUser) {
            currentUser.name = val;
            setCurrentUser(currentUser);
            
            let users = getRegisteredUsers();
            let idx = users.findIndex(u => u.email === currentUser.email);
            if (idx !== -1) {
                users[idx].name = val;
                saveUsers(users);
            }
        }
        document.getElementById('displayUserName').innerText = val;
    }
    closeNameEditModal();
};

