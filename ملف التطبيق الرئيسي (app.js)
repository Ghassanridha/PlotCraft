let touchStartX = 0;
let touchEndX = 0;

const webViewElem = document.getElementById('webViewScreen');
webViewElem.addEventListener('touchstart', e => {
    touchStartX = e.changedTouches[0].screenX;
}, false);

webViewElem.addEventListener('touchend', e => {
    touchEndX = e.changedTouches[0].screenX;
    let diff = touchEndX - touchStartX;
    if (Math.abs(diff) > 70) {
        closeWebView();
    }
}, false);

window.tempSelectLanguage = function(langName, element) {
    var rows = document.querySelectorAll('.lang-item-row');
