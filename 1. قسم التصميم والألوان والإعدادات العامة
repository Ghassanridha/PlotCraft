/* ========================================== */
/* 1. قسم التحرير والألوان والإعدادات العامة (مؤمن ومحدث) */
/* ========================================== */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    -webkit-tap-highlight-color: transparent;
}

html, body {
    width: 100%;
    height: 680px;
    background-color: #0b0f19;
    overflow: hidden;
    position: relative;
}

/* تنسيقات الأمان الإضافية لحماية عناصر الواجهة والنوافذ المنبثقة */
.screen-view {
    display: none;
    width: 100%;
    height: 100%;
}

.screen-view.active {
    display: block;
}

/* تأمين طبقات الحماية والنوافذ ضد التلاعب البصري */
.subscription-modal-overlay, 
.login-modal-overlay, 
.source-modal {
    transition: opacity 0.3s ease;
}

.hidden {
    display: none !important;
}

