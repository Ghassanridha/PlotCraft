<!-- دوال التحكم البرمجية (JavaScript Logic) -->
<!-- ========================================== -->
<script>
    window.PlotCraftModules = window.PlotCraftModules || {};
    window.PlotCraftModules.mainViewsLoaded = true;

    let hasCharacter = false;
    let hasStory = false;
    let savedCharacterName = '';
    let savedStoryText = '';

    // المربع الكبير مخصص فقط للصور الأفقية ولا ينقل لأي مكان عند النقر عليه
    function handleHorizontalBoxClick(event) {
        event.stopPropagation();
        // لا يوجد انتقال هنا، البلاطة مخصصة للصور الأفقية فقط كما طلبت
    }

    // زر الإضافة الصغير المجاور هو وحده الذي ينقل لاختيار الألبوم أو الكاميرا
    function openCharacterModal(event) {
        if (event) event.stopPropagation();
        
        let name = prompt("أدخل اسم الشخصية:");
        if (!name) return;
        let imgUrl = prompt("أدخل رابط الصورة أوانتقر لمكتبة الصور:") || "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150";

        savedCharacterName = name;
        hasCharacter = true;

        document.getElementById('display-char-name').innerText = savedCharacterName;
        document.getElementById('display-char-avatar').style.backgroundImage = `url(${imgUrl})`;
        
        document.getElementById('char-preview-card').style.display = 'flex';
        document.getElementById('horizontal-image-container').style.display = 'none';
        document.getElementById('char-status-text').innerText = 'تمت إضافة 1، الحد الأقصى 2';
        document.getElementById('char-check-icon').style.display = 'inline';
    }

    // دالة حذف الشخصية (زر X) لإعادتها للوضع الأصلي
    function removeCharacter() {
        hasCharacter = false;
        savedCharacterName = '';

        document.getElementById('char-preview-card').style.display = 'none';
        document.getElementById('horizontal-image-container').style.display = 'flex';
        document.getElementById('char-status-text').innerText = 'تمت إضافة 0، الحد الأقصى 2';
        document.getElementById('char-check-icon').style.display = 'none';
    }

    // دالة فتح واجهة الحكاية
    function openStoryModal() {
        let story = prompt("اكتب نص الحكاية هنا:");
        if (!story) return;

        savedStoryText = story;
        hasStory = true;

        document.getElementById('display-story-snippet').innerText = savedStoryText.substring(0, 15) + '...';
        
        document.getElementById('story-preview-card').style.display = 'flex';
        document.getElementById('add-story-trigger-btn').style.display = 'none';
        document.getElementById('story-check-icon').style.display = 'inline';
    }

    // اختيار المدة وتحديث الأرصدة
    function selectDuration(dur, btn) {
        document.querySelectorAll('.dur-btn').forEach(b => {
            b.style.background = '#141419';
            b.style.border = '1px solid #2e2e3a';
            b.style.fontWeight = 'normal';
        });
        btn.style.background = 'linear-gradient(135deg, #e91e63, #8e24aa)';
        btn.style.border = 'none';
        btn.style.fontWeight = '600';
        
        let pts = dur === 3 ? 75 : (dur === 5 ? 125 : 25);
        document.getElementById('points-counter').innerText = pts;
    }

    // اختيار النسبة
    function selectRatio(ratio, btn) {
        document.querySelectorAll('.ratio-btn').forEach(b => {
            b.style.background = '#141419';
            b.style.border = '1px solid #2e2e3a';
            b.style.fontWeight = 'normal';
        });
        btn.style.background = 'linear-gradient(135deg, #e91e63, #8e24aa)';
        btn.style.border = 'none';
        btn.style.fontWeight = '600';
    }

    // زر الإنشاء النهائي
    function startFinalGeneration() {
        if (!hasCharacter || !hasStory) {
            alert('يرجى إضافة الشخصية والحكاية أولاً!');
            return;
        }
        alert('جاري إنشاء الفيديو بالذكاء الاصطناعي بنجاح!');
    }
</script>
