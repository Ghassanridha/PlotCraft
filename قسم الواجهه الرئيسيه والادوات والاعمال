</div>

<!-- 4. شاشة إعداد القصة والخطوات (Step By Step / Story Setup Screen) -->
<div id="stepByStepScreen" class="screen-view" style="display: none; padding: 16px; overflow-y: auto; height: 100vh; padding-bottom: 90px; background-color: #121212; color: #ffffff; font-family: system-ui, sans-serif;">
    
    <!-- رأس الشاشة العرضي -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
        <span style="font-size: 1.1rem; font-weight: 600;">إعداد القصة</span>
        <span style="background: rgba(255,255,255,0.08); padding: 2px 10px; border-radius: 12px; font-size: 0.8rem; color: #a0a0b0;">2/2</span>
    </div>

    <div style="font-size: 0.82rem; color: #9e9ea7; margin-bottom: 16px;">أضف الشخصيات والقصة أولاً، ثم اختر المدة والنسبة.</div>

    <!-- البطاقة الحاضنة الكبرى -->
    <div style="background-color: #1a1a22; border: 1px solid #2a2a35; border-radius: 20px; padding: 16px; display: flex; flex-direction: column; gap: 16px;">

        <!-- قسم الشخصيات -->
        <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 0.95rem; font-weight: 600;">الشخصيات</span>
                    <span id="char-check-icon" style="color: #4caf50; display: none;">✓</span>
                </div>
                <span id="char-status-text" style="font-size: 0.78rem; color: #9e9ea7;">تمت إضافة 0، الحد الأقصى 2</span>
            </div>

            <!-- بطاقة الشخصية بعد إضافتها (تظهر يميناً، زر X وزر تغيير يساراً) -->
            <div id="char-preview-card" style="display: none; background: #141419; border: 1px solid #2e2e3a; border-radius: 14px; padding: 10px 14px; align-items: center; justify-content: space-between; position: relative;">
                <button onclick="removeCharacter()" style="position: absolute; top: 6px; left: 6px; background: #262633; border: none; color: #ccc; width: 22px; height: 22px; border-radius: 50%; font-size: 0.7rem; cursor: pointer; display: flex; align-items: center; justify-content: center;">✕</button>
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div id="display-char-avatar" style="width: 48px; height: 48px; border-radius: 12px; background-size: cover; background-position: center; background-color: #333;"></div>
                    <span id="display-char-name" style="font-size: 0.9rem; font-weight: 500;">ع</span>
                </div>
                <button onclick="openCharacterModal()" style="background: #2b2b3a; border: none; color: white; padding: 6px 14px; border-radius: 10px; font-size: 0.8rem; cursor: pointer; display: flex; align-items: center; gap: 4px;">تغيير 🔄</button>
            </div>

            <!-- المربع الكبير الخاص بالصور الأفقية (ثابت ولا ينقل لمكتبة أو كاميرا عند النقر عليه) -->
            <div id="horizontal-image-container" onclick="handleHorizontalBoxClick(event)" style="width: 100%; background: #141419; border: 1px dashed #3a3a4d; border-radius: 14px; padding: 16px; cursor: default; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;">
                <div style="font-size: 0.85rem; color: #a0a0b0;" data-tr="horizontalBoxTitle">اختر صورة أفقية للشخصية</div>
                
                <!-- زر الإضافة الصغير المجاور الذي ينقل لمكتبة الصور أو الكاميرا -->
                <button id="add-char-trigger-btn" onclick="openCharacterModal(event)" style="background: transparent; border: 1px dashed #739df0; border-radius: 10px; padding: 8px 16px; color: #739df0; font-size: 0.85rem; cursor: pointer;">
                    + إضافة
                </button>
            </div>
        </div>

        <!-- قسم الحكاية -->
        <div style="border-top: 1px solid rgba(255,255,255,0.05); padding-top: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 0.95rem; font-weight: 600;">الحكاية</span>
                    <span id="story-check-icon" style="color: #4caf50; display: none;">✓</span>
                </div>
            </div>

            <button id="add-story-trigger-btn" onclick="openStoryModal()" style="width: 100%; background: transparent; border: 1px dashed #3a3a4d; border-radius: 14px; padding: 14px; color: #739df0; font-size: 0.9rem; cursor: pointer; text-align: center;">
                + إضافة حكاية
            </button>

            <!-- بطاقة الحكاية بعد إضافتها -->
            <div id="story-preview-card" style="display: none; background: #141419; border: 1px solid #2e2e3a; border-radius: 14px; padding: 12px 14px; align-items: center; justify-content: space-between;">
                <div id="display-story-snippet" style="font-size: 0.9rem; font-weight: 500; color: #ddd;">ع</div>
                <button onclick="openStoryModal()" style="background: #2b2b3a; border: none; color: white; padding: 6px 14px; border-radius: 10px; font-size: 0.8rem; cursor: pointer; display: flex; align-items: center; gap: 4px;">تعديل ✏️</button>
            </div>
        </div>

        <!-- تلميح الـ AI -->
        <div style="background: linear-gradient(135deg, rgba(233,30,99,0.12), rgba(142,36,170,0.12)); border: 1px solid rgba(233,30,99,0.25); border-radius: 14px; padding: 12px; display: flex; align-items: flex-start; gap: 10px;">
            <div style="width: 32px; height: 32px; background: linear-gradient(135deg, #e91e63, #8e24aa); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.75rem; flex-shrink: 0; color: white;">AI</div>
            <div>
                <div style="font-size: 0.85rem; color: #ff80ab; font-weight: 600; margin-bottom: 2px;">اختر المدة والنسبة</div>
                <div style="font-size: 0.75rem; color: #a0a0b0; line-height: 1.4;">المدة تحدد كثافة القصة، والنسبة تحدد العرض الأفقي أو الرأسي.</div>
            </div>
        </div>

        <!-- قسم إعدادات المدة والنسبة -->
        <div style="border-top: 1px solid rgba(255,255,255,0.05); padding-top: 12px;">
            <div style="font-size: 0.82rem; color: #9e9ea7; margin-bottom: 8px;">المدة</div>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">
                <button class="dur-btn active" onclick="selectDuration(1, this)" style="background: linear-gradient(135deg, #e91e63, #8e24aa); border: none; color: white; padding: 10px; border-radius: 10px; text-align: center; font-size: 0.85rem; cursor: pointer; font-weight: 600;">1 د</button>
                <button class="dur-btn" onclick="selectDuration(3, this)" style="background: #141419; border: 1px solid #2e2e3a; color: white; padding: 10px; border-radius: 10px; text-align: center; font-size: 0.85rem; cursor: pointer;">3 د</button>
                <button class="dur-btn" onclick="selectDuration(5, this)" style="background: #141419; border: 1px solid #2e2e3a; color: white; padding: 10px; border-radius: 10px; text-align: center; font-size: 0.85rem; cursor: pointer;">5 د</button>
            </div>

            <div style="font-size: 0.82rem; color: #9e9ea7; margin-top: 14px; margin-bottom: 8px;">النسبة</div>
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px;">
                <button class="ratio-btn active" onclick="selectRatio('9:16', this)" style="background: linear-gradient(135deg, #e91e63, #8e24aa); border: none; color: white; padding: 10px; border-radius: 10px; text-align: center; font-size: 0.85rem; cursor: pointer; font-weight: 600;">9:16 📱</button>
                <button class="ratio-btn" onclick="selectRatio('16:9', this)" style="background: #141419; border: 1px solid #2e2e3a; color: white; padding: 10px; border-radius: 10px; text-align: center; font-size: 0.85rem; cursor: pointer;">16:9 🖥️</button>
            </div>

            <div style="text-align: center; color: #ff80ab; font-size: 0.85rem; margin: 16px 0;">
                ✨ يستهلك <span id="points-counter">25</span> من الأرصدة
            </div>

            <!-- زر التأسيس / إنشاء -->
            <button id="final-action-btn" onclick="startFinalGeneration()" style="width: 100%; background: linear-gradient(135deg, #e91e63, #8e24aa); color: white; border: none; padding: 14px; border-radius: 25px; font-weight: 600; font-size: 0.95rem; cursor: pointer; box-shadow: 0 4px 15px rgba(233,30,99,0.3);">إنشاء</button>
        </div>

    </div>
</div>

