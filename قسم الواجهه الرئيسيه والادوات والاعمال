            <div class="movie-card m2" onclick="showToast('يتم إضافة القصص قريباً')"><div class="movie-title">SECRET BILLIONAIRE</div></div>
            <div class="movie-card m3" onclick="showToast('يتم إضافة القصص قريباً')"><div class="movie-title">CYBER CITY</div></div>
